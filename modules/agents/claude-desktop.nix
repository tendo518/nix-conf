# Configure Claude Desktop's Cowork 3P gateway from the same provider table
# used by the CLI agents.
#
# DeepSeek accepts Anthropic-looking gateway routes and maps claude-sonnet-*
# to deepseek-flash server-side, so no local proxy is needed. The API key comes
# from the provider's agenix secret at runtime and is never embedded in the Nix
# store. App-managed settings are preserved by merging with jq.
{
  flake.modules.home."agents/claude-desktop" =
    {
      config,
      lib,
      pkgs,
      ...
    }:
    let
      isDarwin = pkgs.stdenv.hostPlatform.isDarwin;
      homeDir = config.home.homeDirectory;

      providers = import ./_providers.nix { inherit config lib; };
      selected = providers.selectProviders "claudeDesktop";
      enabled = isDarwin && selected != { };
      provider = selected.${providers.defaultProvider selected};
      agentConfig = provider.agentConfig;
      profileName = agentConfig.profileName or provider.name;
      defaultModelName = agentConfig.defaultModel or provider.defaultModel;
      defaultModel = provider.models.${defaultModelName};
      modelNames = agentConfig.models or [ defaultModelName ];
      orderedModelNames = lib.unique (
        lib.optional (builtins.elem defaultModelName modelNames) defaultModelName ++ modelNames
      );

      jq = lib.getExe pkgs.jq;

      inferenceModels = map (
        modelName:
        let
          model = provider.models.${modelName};
        in
        {
          name = model.claudeBehavesAs;
          labelOverride = model.displayName;
        }
        // lib.optionalAttrs (model.contextWindow >= 950000) {
          supports1m = true;
        }
      ) orderedModelNames;

      configureClaudeDesktop = ''
        if [ ! -r "${provider.secretPath}" ]; then
          echo "[claude-desktop] ${profileName} API key is not readable yet; skipping 3P configuration." >&2
          exit 0
        fi

        secretPath="${provider.secretPath}"
        normalDir="${homeDir}/Library/Application Support/Claude"
        thirdPartyDir="${homeDir}/Library/Application Support/Claude-3p"
        meta="$thirdPartyDir/configLibrary/_meta.json"

        mkdir -p "$normalDir" "$thirdPartyDir/configLibrary"

        normalConfig="$normalDir/claude_desktop_config.json"
        thirdPartyConfig="$thirdPartyDir/claude_desktop_config.json"

        [ -f "$normalConfig" ] || printf '{}\n' > "$normalConfig"
        [ -f "$thirdPartyConfig" ] || printf '{}\n' > "$thirdPartyConfig"

        for f in "$normalConfig" "$thirdPartyConfig"; do
          tmp="$f.tmp"
          "${jq}" '.deploymentMode = "3p"' "$f" > "$tmp"
          mv "$tmp" "$f"
        done

        [ -f "$meta" ] || printf '{}\n' > "$meta"

        # Claude Desktop only accepts config IDs matching /^[a-f0-9-]{36}$/.
        # Use the provider's stable UUID instead of the random one generated by
        # the GUI when the config library is first created.
        profileId="${agentConfig.profileId}"
        profileName="${profileName}"
        oldProfileId="$("${jq}" -r '.appliedId // empty' "$meta")"

        if [ -n "$oldProfileId" ] && [ "$oldProfileId" != "$profileId" ] && [ -f "$thirdPartyDir/configLibrary/$oldProfileId.json" ] && [ ! -f "$thirdPartyDir/configLibrary/$profileId.json" ]; then
          cp "$thirdPartyDir/configLibrary/$oldProfileId.json" "$thirdPartyDir/configLibrary/$profileId.json"
        fi

        profile="$thirdPartyDir/configLibrary/$profileId.json"
        [ -f "$profile" ] || printf '{}\n' > "$profile"

        tmp="$meta.tmp"
        "${jq}" --arg id "$profileId" --arg name "$profileName" --arg old "$oldProfileId" '
          .appliedId = $id
          | .entries = (((.entries // []) | map(select(.id != $id and .id != $old))) + [{"id": $id, "name": $name}])
        ' "$meta" > "$tmp"
        mv "$tmp" "$meta"

        tmp="$profile.tmp"
        "${jq}" \
          --arg base "${provider.endpoints.anthropic}" \
          --rawfile key "$secretPath" \
          --argjson models ${lib.escapeShellArg (builtins.toJSON inferenceModels)} \
          --arg effort "${defaultModel.thinking.default}" '
            .inferenceProvider = "gateway"
            | .inferenceCredentialKind = "static"
            | .inferenceGatewayBaseUrl = $base
            | .inferenceGatewayApiKey = ($key | rtrimstr("\n"))
            | .modelPrefer1mContext = false
            | .defaultModelEffort = $effort
            | .inferenceModels = $models
          ' "$profile" > "$tmp"
        mv "$tmp" "$profile"
      '';
    in
    lib.mkIf enabled {
      assertions = [
        {
          assertion = modelNames != [ ];
          message = "Claude Desktop requires at least one model in agents.claudeDesktop.models";
        }
      ];

      age.secrets = providers.ageSecrets selected;

      home.activation.configureClaudeDesktop = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
        (
          ${configureClaudeDesktop}
        )
      '';
    };
}
